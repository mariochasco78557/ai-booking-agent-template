# Per-client deployment variables (placeholders only). Copy to .env on the client's host; never commit .env.
CLIENT_ID=<client-id>
CALENDAR_PROVIDER=memory
# CALENDAR_PROVIDER=google-calendar
# GOOGLE_SERVICE_ACCOUNT_JSON=/etc/booking/<client-id>/service-account.json
AI_WEBHOOK_SECRET=<at-least-16-random-chars>
VOICE_SLOT_TOKEN_SECRET=<at-least-32-random-chars>
ENABLE_WRITE_OPERATIONS=false
