# Copy to .env and fill in. Placeholders only: never commit a real .env.
# Every variable is documented (with its default and fail-closed rules) in src/config/env.ts.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Which client folder to load (clientes/<CLIENT_ID>/cliente.yaml). Default: demo-salon.
CLIENT_ID=demo-salon

# Calendar backend: memory (in-process emulator, no credentials) | google-calendar
CALENDAR_PROVIDER=memory
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/outside/the/repo/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=<base64 of the service-account JSON>

# Shared secret the voice/WhatsApp agents send in x-ai-webhook-secret (>= 16 chars).
AI_WEBHOOK_SECRET=<replace-with-at-least-16-random-chars>
# HMAC key for slot tokens the model must echo back to book (>= 32 chars).
VOICE_SLOT_TOKEN_SECRET=<replace-with-at-least-32-random-chars>

# Writes are OFF by default. Each operation needs the master switch AND its own flag.
ENABLE_WRITE_OPERATIONS=false
ENABLE_CREATE_BOOKING=false
ENABLE_CANCEL_BOOKING=false
ENABLE_UPDATE_BOOKING=false

# WhatsApp confirmations (Meta Cloud API). off | dry_run | live
WHATSAPP_NOTIFICATIONS_MODE=off
# WHATSAPP_ACCESS_TOKEN=<meta-access-token>
# WHATSAPP_PHONE_NUMBER_ID=<meta-phone-number-id>

# Owner notifications on Telegram. off | dry_run | live
TELEGRAM_NOTIFY_MODE=off
# TELEGRAM_BOT_TOKEN=<bot-token>
# TELEGRAM_CHAT_ID=<chat-id>

# Only for a credential-based REST backend adapter (the bundled adapters ignore them).
# BOOKING_USERNAME=<service-account-user>
# BOOKING_PASSWORD=<service-account-password>
