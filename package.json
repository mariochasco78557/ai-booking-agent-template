{
  "name": "ai-booking-agent-template",
  "version": "0.1.0",
  "private": true,
  "description": "Template for LLM booking agents (WhatsApp + voice): Fastify tool API with strict Zod schemas, deterministic call engine, pluggable calendar adapters and a large test suite.",
  "license": "MIT",
  "author": "Flowara AI",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "voice:elevenlabs:synthetic": "tsx src/voice/elevenlabs/server.ts",
    "booking:web:demo": "tsx src/bookingWeb/main.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.1",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "nock": "^13.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
